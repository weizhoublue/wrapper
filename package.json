{
  "name": "wrapper",
  "version": "0.7.0",
  "description": "One-shot CLI wrapper for AI coding agents",
  "bin": {
    "wrapper": "./src/main.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js test/**/*.test.js",
    "build": "npm run build:bundle && npm run build:patch && npm run build:pkg",
    "build:bundle": "esbuild src/main.js --bundle --platform=node --format=cjs --target=node18 --outfile=dist/wrapper-bundle.js",
    "build:patch": "node scripts/patch-bundle.js",
    "build:pkg": "pkg dist/wrapper-bundle.js --targets node18-macos-arm64,node18-linux-x64,node18-linux-arm64 --output dist/wrapper",
    "start": "node src/main.js"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.21.1",
    "@anthropic-ai/claude-agent-sdk": "^0.2.133"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.19.0",
    "esbuild": "^0.28.0"
  }
}
